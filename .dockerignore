# Allowlist: local state, inventory, Git metadata, credentials and test fixtures
# never enter the build context. Keep migration files with the application.
**
!Dockerfile
!.dockerignore
!requirements.txt
!requirements.yml
!container_entrypoint.py
!alembic.ini
!alembic/
!alembic/**
!app/
!app/**
!playbooks/
!playbooks/**
**/__pycache__
**/*.pyc
**/.env*
**/*private_key*
**/*.pem
**/*.key
