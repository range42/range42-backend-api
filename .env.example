# .env.example — Copy to .env and fill in values
# Required
PROJECT_ROOT_DIR=           # Path to this project root
VAULT_PASSWORD_FILE=        # Path to vault password file
# OR
# VAULT_PASSWORD=           # Vault password string (alternative to file)

# Playbook sources
API_BACKEND_WWWAPP_PLAYBOOKS_DIR=     # Local playbooks directory (usually same as PROJECT_ROOT_DIR)
API_BACKEND_PUBLIC_PLAYBOOKS_DIR=     # External playbooks repo path
API_BACKEND_INVENTORY_DIR=            # Ansible inventory directory
API_BACKEND_VAULT_FILE=               # Vault-encrypted variables file

# APT Mirror (infra health endpoint)
APT_MIRROR_HOST=            # Hostname or IP of the apt-mirror VM
APT_MIRROR_NGINX_PORT=80    # nginx port on the mirror VM
APT_MIRROR_AIRGAPPED=       # Set to "true" if using aptly (air-gapped mode)

# Optional
CORS_ORIGIN_REGEX=          # Custom CORS regex (default: localhost only)
HOST=0.0.0.0                # Server bind address
PORT=8000                   # Server port
DEBUG=false                 # Enable debug mode

# Native scenario firewall preparation may add shared DC/node management accepts.
# Only an administrator should enable this; each scenario must also explicitly opt in.
# This does not authorize or enable datacenter/node firewall switches.
RANGE42_SCENARIO_MANAGEMENT_ACCESS=0

# Native scenarios: run as the existing deployment user on deployer-cli.
# See docs/native-scenarios.md. These do not create or select a live context.
# RANGE42_CONTEXT_ROOT=/home/deployer/range42.config
# RANGE42_CONTEXT_SCRIPT=/home/deployer/range42/range42/roles/deployer.bootstrap/files/range42-context.sh
# RANGE42_NATIVE_CONTEXTS_FILE=/etc/range42/native-contexts.json
